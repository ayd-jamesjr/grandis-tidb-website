# Copy this file to .env for local development.
# Never commit .env or enter real credentials in this example file.

TIDB_HOST=your_tidb_host
TIDB_PORT=4000
TIDB_DB_NAME=your_database_name
TIDB_USER=your_database_user
TIDB_PASSWORD=replace_with_your_rotated_password

# Linux/Docker system CA bundle (default in db.php).
# On Windows, download the ISRG Root X1 certificate from the official TiDB
# Cloud TLS instructions and set this to its local PEM file path.
# Example: TIDB_SSL_CA=C:/certs/isrgrootx1.pem
# TIDB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
